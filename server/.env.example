# 伺服器設定
PORT=3000
BASE_URL=http://localhost:3000

# 藍新金流（NewebPay）MPG 全支付方式 — 商店專屬機密資訊
# 請至藍新金流商店後台「特店資料」取得，切勿提交到版本控制或公開分享
NEWEBPAY_MERCHANT_ID=YOUR_MERCHANT_ID
NEWEBPAY_HASHKEY=YOUR_HASHKEY
NEWEBPAY_HASHIV=YOUR_HASHIV

# 測試環境（沙盒）：https://ccore.newebpay.com/MPG/mpg_gateway
# 正式環境：https://core.newebpay.com/MPG/mpg_gateway
NEWEBPAY_MPG_URL=https://ccore.newebpay.com/MPG/mpg_gateway
